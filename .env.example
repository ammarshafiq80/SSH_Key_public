# Production Configuration for SSH Key Management API

# Environment Variables
export FLASK_ENV=production
export FLASK_DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Security Settings
# Add these for production:
# export SECRET_KEY=your-secret-key-here
# export JWT_SECRET_KEY=your-jwt-secret-here

# CORS Settings
CORS_ORIGINS=*

# File Paths (customize as needed)
AUTHORIZED_KEYS_FILE=authorized_keys
SSH_KEY_PUB_FILE=ssh_key.pub

# Logging
LOG_LEVEL=INFO
LOG_FILE=api.log

# Rate Limiting (implement as needed)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Database (for future enhancement)
# DATABASE_URL=sqlite:///ssh_keys.db

# Authentication (for future enhancement)  
# AUTH_ENABLED=true
# API_KEY_REQUIRED=true